rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ⚠️ لازم يطابق نفس القيمة الموجودة في VITE_ADMIN_EMAIL بملف .env بالضبط (أحرف صغيرة).
    // إذا تغيّر إيميل الأدمن يوماً، لازم تحدّث القيمة هنا وتعيد نشر القواعد.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "halradhi97@gmail.com";
    }

    // ── المنتجات ──
    // - قراءة: مفتوحة للجميع
    // - إضافة/حذف/تعديل أي حقل: الأدمن فقط
    // - استثناء ضيّق: أي مستخدم مسجّل دخول يقدر يعدّل حقل الكمية (quantity) بس — يسمح بخصم الكمية
    //   فوراً وقت تأكيد الطلب (يمنع بيع نفس القطعة لأكثر من شخص)، واسترجاعها لو ألغى طلبه بنفسه
    // ⚠️ الفرق محدود بـ 20 وحدة كحد أقصى بكل عملية — يمنع مستخدم خبيث من تلفيق الكمية لرقم عشوائي كبير
    //   (زي تصفير كمية منتج غيره أو تضخيمها)، مع بقاء المجال كافٍ لأي طلب حقيقي بكمية معقولة
    match /products/{id} {
      allow read:  if true;
      allow write: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["quantity"])
            && request.resource.data.quantity >= 0
            && (request.resource.data.quantity - resource.data.quantity) <= 20
            && (resource.data.quantity - request.resource.data.quantity) <= 20);
    }

    // ── الطلبات ──
    // - إنشاء: يتطلب تسجيل دخول الآن (إتمام الطلب صار يفرض ذلك بالواجهة أصلاً)، وبحالة "pending" فقط،
    //   و userId بالمستند لازم يطابق هوية اللي يكتب — يمنع أي شخص يفبرك طلب باسم حساب غيره
    // - جلب طلب واحد بمعرفه (get): مفتوح — تتبع الطلب يعتمد على معرفة رقم الطلب نفسه (غير قابل للتخمين)
    // - سرد/استعلام الطلبات (list): الأدمن فقط، أو المستخدم المسجل لطلباته هو فقط
    // - تعديل: الأدمن، أو صاحب الطلب المسجل (أو طلب زائر قديم بلا userId) يقدر بس يلغي طلبه وهو لسا "pending"
    // - حذف: الأدمن فقط
    match /orders/{id} {
      allow get:    if true;
      allow list:   if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      // ✅ فحوصات إضافية تمنع مستندات مفبركة/مشوّهة (سلة فاضية، إجمالي بالسالب، عدد بنود غير معقول)
      allow create: if isSignedIn()
        && request.resource.data.status == "pending"
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow update: if isAdmin() ||
        (resource.data.status == "pending" &&
         request.resource.data.status == "rejected" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
         (resource.data.userId == null || (isSignedIn() && request.auth.uid == resource.data.userId)));
      allow delete: if isAdmin();
    }

    // ── المستخدمون ──
    // - قراءة: صاحب الحساب فقط، أو الأدمن
    // - إنشاء أول مرة (تسجيل حساب جديد): صاحب الحساب فقط، وبس لنفس uid
    // - تعديل: الأدمن يقدر يغيّر أي شي (لإدارة الرصيد يدوياً) — العميل نفسه يقدر يعدّل بياناته الشخصية بس
    //   (الاسم/الهاتف/العنوان)، أو ينقص رصيده هو بس وقت ما يستخدمه بالدفع (ما يقدر يزوّد رصيده لنفسه أبداً)
    match /users/{uid} {
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","phone","address"]))
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["balance"])
            && request.resource.data.balance < resource.data.balance
            && request.resource.data.balance >= 0);
      allow delete: if isAdmin();
    }

    // ── الإعدادات ──
    // إعدادات تلجرام (توكن البوت) تصير للأدمن فقط — Cloud Function تقرأها من السيرفر بصلاحيات كاملة
    // (Admin SDK يتجاوز هالقواعد أصلاً)، فالمتصفح ما يحتاج يقرأها إطلاقاً بعد الحين
    // إعدادات ntfy (اسم الـ topic) مقروءة للكل بالتصميم — المتصفح يرسل الإشعار مباشرة وقت الطلب،
    // وانكشاف اسم الـ topic خطره محدود جداً (مو مفتاح تحكم زي توكن بوت)
    // باقي الإعدادات (رسوم التوصيل، IBAN، الواتساب...) تبقى مقروءة للكل — تحتاجها صفحة الدفع حتى للزوار
    match /settings/{id} {
      allow read:  if id != "telegram" || isAdmin();
      allow write: if isAdmin();
    }

    // ── معاملات الولاء — العميل يشوف معاملاته فقط، الأدمن يشوف/يكتب الكل ──
    match /loyaltyTransactions/{id} {
      allow get:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list:  if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow write: if isAdmin();
    }

    // ── تقييمات المنتجات ──
    // - قراءة: التقييمات المعتمدة (approved) تظهر للجميع، الأدمن يشوف الكل، والعميل يشوف تقييماته
    //   هو بس (حتى لو لسا قيد المراجعة) — يعرف إذا انتشر أو لا
    // - إضافة: لازم تسجيل دخول + تقييم بين 1-5 + تعليق ≤1000 حرف + الحالة تبدأ "pending" دايماً
    //   (ما تقدر تنشر مباشرة بدون موافقة الأدمن) + orderId لازم يرجع لطلب حقيقي لهذا المستخدم
    //   وحالته "delivered" أو "collected" — يعني لازم يكون عميل فعلي أكمل عملية شراء
    // - تعديل الحالة (موافقة/رفض): الأدمن فقط
    // - حذف: الأدمن، أو صاحب التقييم نفسه بس وهو لسا قيد المراجعة (قبل ما يوافق عليه الأدمن)
    match /reviews/{id} {
      allow get:  if true;
      allow list: if resource.data.status == "approved"
        || isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.productId is string
        && request.resource.data.orderId is string
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status in ["delivered","collected"];
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == "pending");
    }
  }
}
