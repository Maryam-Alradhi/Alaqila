# ══════════════════════════════════════════════════════
# انسخ هذا الملف وسمّه .env واملأ القيم الحقيقية
# ══════════════════════════════════════════════════════

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Telegram — يمكن الآن ضبطه من لوحة الأدمن مباشرة (Settings > Telegram)
# هذه القيم احتياطية فقط، تُفضّل إعداداتFire store
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Benefit Pay — يمكن ضبطه من لوحة الأدمن (Settings > Store)
VITE_BENEFIT_IBAN=

# WhatsApp — يمكن ضبطه من لوحة الأدمن (Settings > Store)
VITE_WHATSAPP_NUMBER=

# إيميل حساب الأدمن — يجب أن يتطابق مع حساب Firebase Auth
VITE_ADMIN_EMAIL=

# App Check (اختياري) — مفتاح reCAPTCHA v3 من Firebase Console > App Check
# لو تركته فاضي، الموقع يشتغل عادي بدون App Check
VITE_RECAPTCHA_SITE_KEY=
