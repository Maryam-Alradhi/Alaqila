# ══════════════════════════════════════════════════════
# انسخ هذا الملف وسمّه .env واملأ القيم الحقيقية
# ⚠️ لا تحطي قيم حقيقية بهذا الملف — هذا الملف يرفع لـ GitHub (المستودع عام)
# القيم الحقيقية تنحط بملف .env بس (محلي، ما يرفع أبداً)
# ══════════════════════════════════════════════════════

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Benefit Pay — يمكن ضبطه من لوحة الأدمن (Settings > Store) بدل هنا
VITE_BENEFIT_IBAN=

# WhatsApp — يمكن ضبطه من لوحة الأدمن (Settings > Store) بدل هنا
VITE_WHATSAPP_NUMBER=

# إيميل حساب الأدمن — يجب أن يتطابق مع حساب Firebase Auth
VITE_ADMIN_EMAIL=

# App Check (اختياري) — مفتاح reCAPTCHA v3 من Firebase Console > App Check
# لو تركته فاضي، الموقع يشتغل عادي بدون App Check
VITE_RECAPTCHA_SITE_KEY=

# EmailJS (اختياري) — إشعار العميل بالإيميل عند تغيّر حالة الطلب. لو تركتها فاضية، الميزة تتعطل بدون أي مشكلة
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# قالب إضافي اختياري — إشعار "رجع متوفر" (يحتاج متغيرات: to_email, product_name, product_url)
VITE_EMAILJS_RESTOCK_TEMPLATE_ID=
